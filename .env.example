# Copy this file to .env and fill in real values for local development.
# On Render, configure these in the dashboard under Environment > Environment Variables.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bank?retryWrites=true&w=majority

# Secret used to sign JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_long_random_secret

# Gmail OAuth2 credentials (for sending notification emails via Nodemailer)
CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_oauth_client_secret
REFRESH_TOKEN=your_google_oauth_refresh_token
EMAIL_USER=your_gmail_address@gmail.com

# Optional — Render injects PORT automatically. Defaults to 5001 locally.
# PORT=5001
